# Optional: API keys for the AI features.
#
# 1. Copy this file and name the copy  secrets.toml  (in this same .streamlit folder).
# 2. Paste your key between the quotes on the line you need.
# 3. Restart the app.
#
# secrets.toml is listed in .gitignore, so it is never uploaded if you use Git.
# You only need ONE of these, matching the provider you pick in Settings -> AI connection.

# Anthropic (Claude). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY = ""

# OpenAI or another OpenAI-compatible service (OpenRouter, etc.).
# Local servers such as Ollama and LM Studio don't need a key.
OPENAI_API_KEY = ""
